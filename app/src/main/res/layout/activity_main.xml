<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- بطاقة بيانات الدخول -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 إعدادات راوتر DWR-921 (Anweb)"
                    android:textColor="#58A6FF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etRouterIp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="#21262D"
                    android:hint="عنوان الراوتر (مثال: 192.168.0.1)"
                    android:inputType="textUri"
                    android:paddingHorizontal="12dp"
                    android:text="192.168.0.1"
                    android:textColor="#C9D1D9"
                    android:textColorHint="#8B949E"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="#21262D"
                    android:hint="كلمة مرور الراوتر"
                    android:inputType="textPassword"
                    android:paddingHorizontal="12dp"
                    android:text="admin"
                    android:textColor="#C9D1D9"
                    android:textColorHint="#8B949E"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- بطاقة التحكم بشبكة رامي ليفي -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ عمليات الاتصال السريع"
                    android:textColor="#7EE787"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- زر الإنعاش الفوري المباشر (المحاكي الدقيق لزر Reconnect) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReconnectWan"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="🔄 إعادة تشغيل الشبكة الآن (RECONNECT)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:backgroundTint="#238636"
                    app:cornerRadius="8dp" />

                <!-- زر تشغيل الحارس التلقائي الذكي -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartWatchdog"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="🛡️ تشغيل حارس النت الذكي (منع التقطيع)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:backgroundTint="#1F6FEB"
                    app:cornerRadius="8dp" />

                <!-- زر حقن MTU 1380 و DNS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyDnsMtu"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="⚙️ حقن MTU 1380 + أسرع DNS في الراوتر"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    app:backgroundTint="#8957E5"
                    app:cornerRadius="8dp" />

                <!-- أزرار الصيانة الإضافية -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnForce4G"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="🔒 قفل 4G فقط"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:backgroundTint="#30363D"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDnsBenchmark"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="📡 قياس البنج"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:backgroundTint="#30363D"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloudServer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="☁️ نبضات تثبيت الاتصال (Cloud Heartbeat)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:backgroundTint="#D29922"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- نافذة السجل الحي والمراقبة (Console) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🖥️ سجل الأداء والعمليات اللحظي:"
            android:textColor="#8B949E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConsole"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="6dp"
            android:background="#010409"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:textColor="#39D353"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
