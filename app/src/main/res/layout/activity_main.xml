<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- بطاقة الحالة والترويسة العصرية -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ DWR-921 Turbo Master"
                        android:textColor="@color/text_white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- شارة البنج المباشرة -->
                    <TextView
                        android:id="@+id/tvLivePingBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ic_launcher"
                        android:backgroundTint="#21262D"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="البنج: -- ms"
                        android:textColor="@color/console_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="شريحة رامي ليفي • وضع 3G HSPA+ فائق الاستقرار"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <!-- حقول الاتصال بالراوتر بتصميم انسيابي -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etRouterIp"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1.3"
                        android:background="@color/input_bg"
                        android:hint="IP الراوتر"
                        android:paddingHorizontal="12dp"
                        android:text="192.168.0.1"
                        android:textColor="@color/text_white"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@color/input_bg"
                        android:hint="كلمة السر"
                        android:inputType="textPassword"
                        android:paddingHorizontal="12dp"
                        android:text="admin"
                        android:textColor="@color/text_white"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- بطاقة العمليات الرئيسية (RECONNECT والحارس) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚀 التحكم المباشر بالشبكة"
                    android:textColor="#58A6FF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- زر الإنعاش الفوري المحاكي لزر RECONNECT في الراوتر -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReconnectWan"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:text="🔄 إعادة تشغيل الشبكة الآن (RECONNECT)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/green_accent"
                    app:cornerRadius="10dp"
                    app:elevation="4dp" />

                <!-- زر حارس النت الذكي لمنع التقطيع -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartWatchdog"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="🛡️ تشغيل حارس رامي ليفي (منع الانقطاع التلقائي)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:backgroundTint="@color/blue_accent"
                    app:cornerRadius="10dp" />

                <!-- زر حقن MTU 1380 و DNS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyDnsMtu"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:text="⚙️ حقن MTU 1380 + أسرع DNS في الراوتر"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:backgroundTint="@color/purple_accent"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- بطاقة إدارة التردد المخصصة لـ 3G HSPA+ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📶 إدارة التردد ونمط الشبكة (منطقتك: 3G)"
                    android:textColor="#F2CC60"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- زر قفل 3G فقط لمنع تشتت الراوتر -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnForce3G"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="🔒 تثبيت 3G فقط"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:backgroundTint="#238636"
                        app:cornerRadius="8dp" />

                    <!-- زر الوضع التلقائي -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAutoNetwork"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="🔄 وضع تلقائي"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:backgroundTint="#30363D"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- فحص البنج -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDnsBenchmark"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="📡 قياس البنج"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:backgroundTint="#21262D"
                        app:cornerRadius="8dp" />

                    <!-- نبضات منع خمول برج 3G -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloudServer"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="☁️ تثبيت البرج"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:backgroundTint="@color/amber_accent"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- نافذة السجل الحي الأنيقة (Console) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🖥️ سجل الأداء والعمليات المباشر:"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearLogs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:text="مسح السجل"
                android:textColor="#58A6FF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvConsole"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="6dp"
            android:background="@color/console_bg"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:textColor="@color/console_text"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
