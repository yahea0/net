<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ DWR-921 Anweb Master Controller"
            android:textColor="#58A6FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="تحكم كامل بالراوتر | صيد 4G | حارس النت | خادم سحابي"
            android:textColor="#8B949E"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etRouterIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#161B22"
            android:padding="10dp"
            android:text="192.168.0.1"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#161B22"
            android:padding="10dp"
            android:text="admin01"
            android:inputType="textPassword"
            android:textColor="#FFFFFF" />

        <!-- الأزرار الرئيسية -->
        <Button
            android:id="@+id/btnForce4G"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#238636"
            android:text="📡 قفل وصيد إشارة 4G LTE بالقوة (Anweb RPC)"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStartWatchdog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#1F6FEB"
            android:text="⚡ تشغيل حارس النت الذكي (منع الانقطاع التلقائي)"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMtuTune"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#D29922"
            android:text="💉 حقن MTU 1380 في الراوتر وإنهاء التقطيع"
            android:textColor="#000000"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDnsBenchmark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8957E5"
            android:text="🌐 فحص وتطبيق أسرع خادم DNS عالمي"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCloudServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#F0883E"
            android:text="☁️ تفعيل نفق الحماية السحابي (Cloudflare DoH)"
            android:textColor="#000000"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="سجل العمليات المباشر (Terminal Console):"
            android:textColor="#C9D1D9"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvConsole"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="6dp"
            android:background="#010409"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:scrollbars="vertical"
            android:text="[READY] تم ربط التطبيق بنظام Anweb الخاص براوترك...\n"
            android:textColor="#39D353"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
